# Virtual environments (any venv* directory)
venv/
venv_ma2/
venv*/

# Model checkpoints (large files)
checkpoints/

# Pipeline outputs (generated)
outputs/

# Input media files (user-specific, may contain personal footage).
# Patterns are recursive: inputs/*.mp4 alone misses inputs/subdir/clip.mp4.
inputs/**/*.mp4
inputs/**/*.avi
inputs/**/*.mov
inputs/**/*.mkv
inputs/**/*.MP4
inputs/**/*.MOV
inputs/**/*.jpg
inputs/**/*.jpeg
inputs/**/*.png
inputs/**/*.bmp
inputs/**/*.webp

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
